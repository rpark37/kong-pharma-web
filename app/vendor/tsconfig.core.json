{
  "extends": "./morphcharts/core/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "incremental": false,
    "sourceMap": false,
    "declarationMap": true,
    "strict": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false
  }
}
